local Clearance = game:GetService('Players').LocalPlayer:WaitForChild('ClearanceData').Level

for n,v in pairs(Teams) do
	local Clone = nil
	
	if Clearance.Value >= v.TeamRequirementLVL then
		Clone = script.Product:Clone()
	else
		Clone = script.ProductBlocked:Clone()
	end
	
	Clone.Title.Text = n
	Clone.Desc.Text = v.Description
	Clone.Detail.Text = v.TeamBackground
	Clone.Detail.TextColor3 = v.TeamBgColor
	Clone.Parent = script.Parent.Holder.Deploy.ScrollingFrame
	Clone.ImageLabel.Image = v.TeamImage
	
	Clone.Become.TextButton.Activated:Connect(function()
		game:GetService("ReplicatedStorage"):FindFirstChild("SCPFMenuRemotes"):FindFirstChild("ChangeTeam"):FireServer(v.Team)
		workspace.CurrentCamera.CameraSubject = game:GetService('Players').LocalPlayer.Character:WaitForChild('Humanoid')
		game:GetService("Players").LocalPlayer.PlayerGui:WaitForChild('Client'):WaitForChild('CameraManipulated').Value = false
		workspace.CurrentCamera.CameraType = "Custom"
		script.Parent.Enabled = false
		game:GetService('StarterGui'):SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
	end)
end
